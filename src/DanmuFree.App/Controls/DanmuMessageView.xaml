<UserControl x:Class="DanmuFree.App.Controls.DanmuMessageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:DanmuFree.App.Converters"
             xmlns:controls="clr-namespace:DanmuFree.App.Controls"
             Focusable="False" UseLayoutRounding="True"
             FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}}">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <c:BadgeBrushConverter x:Key="BadgeBrush"/>
    <c:BadgeFontSizeConverter x:Key="BadgeSize"/>
    <Style x:Key="BadgeText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontSize" Value="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BadgeSize}}"/>
    </Style>
    <Style x:Key="Badge" TargetType="Border">
      <Setter Property="CornerRadius" Value="4"/>
      <Setter Property="Padding" Value="5,1"/>
      <Setter Property="Margin" Value="0,2,5,2"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <Border CornerRadius="9" Background="#68131C2B" BorderBrush="#22C0D4F0"
          BorderThickness="1" Padding="10,7" Margin="0,0,0,7">
    <StackPanel>
      <WrapPanel Margin="0,0,0,3">
        <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm:ss}}" Foreground="#FF8292A7"
                   FontSize="{Binding DataContext.FontSize, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BadgeSize}}"
                   VerticalAlignment="Center" Margin="0,0,7,0"
                   Visibility="{Binding DataContext.ShowTime, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
        <Border Background="{Binding Identity, Converter={StaticResource BadgeBrush}, ConverterParameter=role}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Identity.HasRole}" Value="True"/>
                    <Condition Binding="{Binding DataContext.ShowRoleBadge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding Identity.RoleText}" Style="{StaticResource BadgeText}"/>
        </Border>
        <Border Background="{Binding Identity, Converter={StaticResource BadgeBrush}, ConverterParameter=guard}">
          <Border.Style>
            <Style TargetType="Border" BasedOn="{StaticResource Badge}">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Identity.HasGuard}" Value="True"/>
                    <Condition Binding="{Binding DataContext.ShowGuardBadge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <Path Data="M1,7 L15,7 12,12 4,12 Z M8,0 L8,7 M8,1 L13,5 8,5"
                  Stroke="White" Fill="#55FFFFFF" StrokeThickness="1" Width="12" Height="12"
                  Stretch="Uniform" Margin="0,0,4,0" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Identity.GuardText}" Style="{StaticResource BadgeText}"/>
          </StackPanel>
        </Border>
        <Border CornerRadius="4" BorderThickness="1" Margin="0,2,6,2" VerticalAlignment="Center"
                Background="{Binding Identity.Medal, Converter={StaticResource BadgeBrush}}"
                BorderBrush="{Binding Identity.Medal, Converter={StaticResource BadgeBrush}, ConverterParameter=border}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <MultiDataTrigger>
                  <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Identity.HasMedal}" Value="True"/>
                    <Condition Binding="{Binding DataContext.ShowMedal, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                  </MultiDataTrigger.Conditions>
                  <Setter Property="Visibility" Value="Visible"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding Identity.Medal.IsLit}" Value="False">
                  <Setter Property="Opacity" Value="0.5"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{Binding Identity.Medal.Name}" Style="{StaticResource BadgeText}"
                       Foreground="{Binding Identity.Medal, Converter={StaticResource BadgeBrush}, ConverterParameter=foreground}"
                       Margin="5,1" MaxWidth="160" TextTrimming="CharacterEllipsis"/>
            <Border Background="#E8FFFFFF" CornerRadius="0,3,3,0" Padding="5,1">
              <TextBlock Text="{Binding Identity.Medal.Level}" Style="{StaticResource BadgeText}" Foreground="#FF24344B"/>
            </Border>
          </StackPanel>
        </Border>
        <controls:OutlineHost
            Stroke="{Binding DataContext.DanmuOutlineColor, RelativeSource={RelativeSource AncestorType=Window}}"
            Thickness="{Binding DataContext.DanmuOutlineDepth, RelativeSource={RelativeSource AncestorType=Window}}">
          <TextBlock Text="{Binding UserName}" TextWrapping="Wrap" FontWeight="SemiBold" VerticalAlignment="Center"
                     FontFamily="{Binding DataContext.UserNameFontFamily, RelativeSource={RelativeSource AncestorType=Window}}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{Binding DataContext.UserNameColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <Style.Triggers>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Identity.IsAdmin}" Value="True"/>
                      <Condition Binding="{Binding DataContext.ShowRoleBadge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FF79E1B0"/>
                  </MultiDataTrigger>
                  <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                      <Condition Binding="{Binding Identity.IsAnchor}" Value="True"/>
                      <Condition Binding="{Binding DataContext.ShowRoleBadge, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Foreground" Value="#FFFF95B8"/>
                  </MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </controls:OutlineHost>
      </WrapPanel>
      <controls:OutlineHost
          Stroke="{Binding DataContext.DanmuOutlineColor, RelativeSource={RelativeSource AncestorType=Window}}"
          Thickness="{Binding DataContext.DanmuOutlineDepth, RelativeSource={RelativeSource AncestorType=Window}}">
        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" LineStackingStrategy="MaxHeight"
                   FontFamily="{Binding DataContext.DanmuFontFamily, RelativeSource={RelativeSource AncestorType=Window}}"
                   Foreground="{Binding DataContext.DanmuColor, RelativeSource={RelativeSource AncestorType=Window}}"/>
      </controls:OutlineHost>
    </StackPanel>
  </Border>
</UserControl>
