<UserControl x:Class="DanmuFree.App.Views.RoomAdminPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFCCCCCC"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#FF2A2A2A"/><Setter Property="Foreground" Value="#FFE8E8E8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  </UserControl.Resources>
  <StackPanel Margin="6">
    <TextBlock Text="{Binding Status}" Foreground="#FFFFD54F" Margin="0,0,0,8"/>
    <StackPanel IsEnabled="{Binding CanManage}">
      <TextBlock Text="按 UID 或昵称查找用户"/>
      <DockPanel Margin="0,4,0,4">
        <Button DockPanel.Dock="Right" Content="搜索" Command="{Binding SearchAdminCommand}" Margin="6,0,0,0"/>
        <TextBox Text="{Binding AdminQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="数字按 UID 查询，其他内容按昵称搜索"/>
      </DockPanel>
      <ListBox ItemsSource="{Binding AdminSearchResults}" SelectedItem="{Binding SelectedAdminSearch}" DisplayMemberPath="DisplayName" Height="100"/>
      <TextBlock Text="当前选择" Margin="0,8,0,2"/>
      <TextBlock Text="{Binding AdminTargetText}" Foreground="#FF4FC3F7"/>
      <WrapPanel Margin="0,6,0,10">
        <Button Content="任命房管" Command="{Binding AppointCommand}" Margin="0,0,8,0"/>
        <Button Content="撤销房管" Command="{Binding DismissCommand}"/>
      </WrapPanel>
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshAdminsCommand}"/>
        <TextBlock Text="当前房管名单" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox ItemsSource="{Binding Admins}" SelectedItem="{Binding SelectedAdmin}" DisplayMemberPath="DisplayName" Height="160"/>
      <WrapPanel Margin="0,6,0,0">
        <Button Content="上一页" Command="{Binding PreviousAdminsCommand}"/>
        <TextBlock Text="{Binding AdminPage, StringFormat=第 {0} 页}" VerticalAlignment="Center" Margin="8,0"/>
        <Button Content="下一页" Command="{Binding NextAdminsCommand}" IsEnabled="{Binding HasMoreAdmins}"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock Text="仅主播本人账号可操作；请核对目标 UID。搜索结果和名单不写入本地，断开后清空。" Foreground="#FF888888" FontSize="11" Margin="0,10,0,4"/>
  </StackPanel>
</UserControl>
