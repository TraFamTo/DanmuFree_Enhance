<UserControl x:Class="DanmuFree.App.Views.RoomBanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#FFCCCCCC"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#FF2A2A2A"/><Setter Property="Foreground" Value="#FFE8E8E8"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/></Style>
  </UserControl.Resources>
  <StackPanel Margin="6">
    <TextBlock Text="{Binding Status}" Foreground="#FFFFD54F" Margin="0,0,0,8"/>
    <StackPanel IsEnabled="{Binding CanManage}">
      <TextBlock Text="最近弹幕（最多 200 条，点击选择发送者）"/>
      <ListBox ItemsSource="{Binding RecentMessages}" SelectedItem="{Binding SelectedRecent}" Height="150" Margin="0,4,0,8"
               VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="0,2">
              <TextBlock Foreground="#FF4FC3F7"><Run Text="{Binding UserName}"/><Run Text="  UID: "/><Run Text="{Binding UserId}"/></TextBlock>
              <TextBlock Text="{Binding Text}"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Text="也可以输入 UID 或昵称查找用户"/>
      <DockPanel Margin="0,4,0,4">
        <Button DockPanel.Dock="Right" Content="搜索" Command="{Binding SearchBanCommand}" Margin="6,0,0,0"/>
        <TextBox Text="{Binding BanQuery, UpdateSourceTrigger=PropertyChanged}"/>
      </DockPanel>
      <ListBox ItemsSource="{Binding BanSearchResults}" SelectedItem="{Binding SelectedBanSearch}" DisplayMemberPath="DisplayName" Height="90"/>
      <TextBlock Text="当前选择" Margin="0,8,0,2"/>
      <TextBlock Text="{Binding BanTargetText}" Foreground="#FF4FC3F7"/>
      <WrapPanel Margin="0,6,0,10">
        <TextBlock Text="禁言时长" VerticalAlignment="Center" Margin="0,0,4,0"/>
        <ComboBox ItemsSource="{Binding BanHourChoices}" SelectedItem="{Binding BanHours}" Width="60"/>
        <TextBlock Text="小时" VerticalAlignment="Center" Margin="4,0,8,0"/>
        <Button Content="禁言" Command="{Binding BanCommand}" Margin="0,0,8,0"/>
        <Button Content="解除禁言" Command="{Binding UnbanCommand}"/>
      </WrapPanel>
      <DockPanel Margin="0,0,0,4">
        <Button DockPanel.Dock="Right" Content="刷新" Command="{Binding RefreshBlockedCommand}"/>
        <TextBlock Text="当前禁言名单（点击选择用户）" VerticalAlignment="Center"/>
      </DockPanel>
      <ListBox ItemsSource="{Binding BlockedUsers}" SelectedItem="{Binding SelectedBlocked}" DisplayMemberPath="DisplayName" Height="140"/>
      <WrapPanel Margin="0,6,0,0">
        <Button Content="上一页" Command="{Binding PreviousBlockedCommand}"/>
        <TextBlock Text="{Binding BlockedPage, StringFormat=第 {0} 页}" VerticalAlignment="Center" Margin="8,0"/>
        <Button Content="下一页" Command="{Binding NextBlockedCommand}" IsEnabled="{Binding HasMoreBlocked}"/>
      </WrapPanel>
    </StackPanel>
    <TextBlock Text="解禁会按 UID 查询当前禁言记录。断开后清空此页的弹幕、名单和搜索结果。" Foreground="#FF888888" FontSize="11" Margin="0,10,0,4"/>
  </StackPanel>
</UserControl>
